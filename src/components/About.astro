---
import { Picture } from 'astro:assets';
import logo from '../assets/brand/logo-principal.png';
import Icon from './Icon.astro';
import { about, site } from '../data/site';
---

<section class="section section--tint-lilac" id="sobre-mi" aria-labelledby="sobre-mi-title">
  <div class="container about">
    <!-- MOCK: sustituir por una fotografía profesional (src/assets/karla.jpg) usando <Picture />. -->
    <figure class="about-media">
      <div class="photo-frame">
        <Picture src={logo} alt="" widths={[320, 480, 640]} sizes="(min-width: 62rem) 400px, 80vw" formats={['avif', 'webp']} />
      </div>
      <figcaption>
        <strong>{site.fullName}</strong>
        <span>{site.role} · {site.license}</span>
      </figcaption>
    </figure>

    <div class="about-copy">
      <p class="eyebrow">Sobre mí</p>
      <h2 id="sobre-mi-title">Nutrición con ciencia, empatía y sentido común</h2>
      {about.paragraphs.map((text) => <p>{text}</p>)}
      <ul class="highlights" role="list">
        {
          about.highlights.map((item) => (
            <li>
              <Icon name="check" size={20} />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4.5rem);
    align-items: center;
  }

  @media (min-width: 62rem) {
    .about {
      grid-template-columns: 0.9fr 1.1fr;
    }
  }

  .about-media {
    justify-self: center;
    width: min(100%, 26rem);
  }

  .photo-frame {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    padding: 2rem;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 20% 15%, rgb(143 174 177 / 0.25), transparent 55%),
      radial-gradient(circle at 85% 90%, rgb(200 161 164 / 0.3), transparent 55%),
      var(--white);
    box-shadow: var(--shadow);
  }

  figcaption {
    display: grid;
    gap: 0.15rem;
    margin-top: 1.25rem;
    text-align: center;
  }

  figcaption span {
    font-size: var(--step--1);
    color: var(--muted);
  }

  h2 {
    font-size: var(--step-3);
    margin-bottom: 1.25rem;
  }

  .about-copy > p:not(.eyebrow) {
    color: var(--muted);
  }

  .about-copy > p + p {
    margin-top: 1rem;
  }

  .highlights {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 0.75rem;
    margin-top: 2rem;
    padding: 0;
    list-style: none;
  }

  .highlights li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--white);
    font-weight: 500;
    font-size: var(--step--1);
  }

  .highlights :global(svg) {
    flex-shrink: 0;
    color: var(--rose-700);
  }
</style>
