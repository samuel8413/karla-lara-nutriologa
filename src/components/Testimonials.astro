---
import { testimonials } from '../data/site';
---

<section class="section" id="testimonios" aria-labelledby="testimonios-title">
  <div class="container">
    <header class="section-header section-header--center">
      <p class="eyebrow">Testimonios</p>
      <h2 id="testimonios-title">Lo que dicen mis pacientes</h2>
    </header>

    <ul class="testimonials" role="list">
      {
        testimonials.map((t) => (
          <li>
            <figure class="testimonial">
              <svg class="quote-mark" viewBox="0 0 32 24" width="40" height="30" aria-hidden="true" focusable="false">
                <path
                  fill="currentColor"
                  d="M0 24V14.4C0 6.4 4.3 1.6 12.8 0l1.4 3.2C9.6 4.6 7.4 7.4 7.2 11.2H13V24H0Zm18 0V14.4C18 6.4 22.3 1.6 30.8 0l1.4 3.2c-4.6 1.4-6.8 4.2-7 8H31V24H18Z"
                />
              </svg>
              <blockquote>
                <p>{t.quote}</p>
              </blockquote>
              <figcaption>
                <strong>{t.name}</strong>
                <span>{t.context}</span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .testimonials {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1.25rem;
    padding: 0;
    list-style: none;
  }

  .testimonial {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 2rem;
    border-radius: var(--radius);
    background: var(--lilac-50);
  }

  .quote-mark {
    width: 2.25rem;
    height: auto;
    margin-bottom: 1rem;
    color: var(--brand-rose);
  }

  blockquote {
    flex-grow: 1;
    font-size: var(--step-0);
  }

  figcaption {
    display: grid;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  figcaption span {
    font-size: var(--step--1);
    color: var(--muted);
  }
</style>
